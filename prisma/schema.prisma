generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String?     @unique
  emailVerified DateTime?
  image         String?
  username      String?     @unique // Mantido opcional para compatibilidade
  role          String      @default("PLAYER") // "GM" ou "PLAYER"
  accounts      Account[]
  sessions      Session[]
  characters    Character[]
}

model Character {
  id        String  @id @default(uuid())
  name      String
  level     Int     @default(1)
  money     Int     @default(0)
  avatarUrl String?
  sheetData String  @default("{}") // Campo flexível JSON com atributos, talentos, etc.

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items    Item[]
  pokemons Pokemon[]
  notes    Note[]
}

model Item {
  id          String  @id @default(uuid())
  name        String
  description String?
  quantity    Int     @default(1)
  imageUrl    String?

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model Pokemon {
  id         String  @id @default(uuid())
  nickname   String
  species    String
  isParty    Boolean @default(false)
  boxName    String?
  imageUrl   String?
  pokemonData String @default("{}") // Campo flexível JSON com stats, golpes, etc.

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model Note {
  id      String @id @default(uuid())
  title   String
  content String // Markdown puro

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model TradeRequest {
  id         String @id @default(uuid())
  senderId   String // O Character ID de quem está enviando a troca
  receiverId String // O Character ID de quem está recebendo a oferta
  status     String @default("PENDING") // "PENDING", "ACCEPTED", "REJECTED"
  tradeData  String @default("{}") // Payload JSON com os itens e pokemons ofertados/requisitados
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
